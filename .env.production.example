# Live-server settings. Copy to .env ON THE SERVER and fill in the blanks; never commit the real file.
# Then run: php artisan app:go-live-check   (or open Admin > System check on hosts without SSH)

APP_NAME="Lingayen CivicLink"
APP_ENV=production
# Generate a NEW key for the live site (php artisan key:generate --show); never reuse the development key.
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
# A dedicated database user with a long random password, never root.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Sign-in cookies travel over HTTPS only.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# true on hosts without SSH (no php artisan storage:link): logos are then stored in public/storage.
PUBLIC_UPLOADS_IN_WEB_ROOT=false
# Shared hosts have no queue worker or scheduler: jobs run immediately.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
# Create a NEW Brevo SMTP key for the live site.
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Demo data for the thesis defense only (docs/DEPLOYMENT.md §4D). Leave both off for real use.
# DEMO_PASSWORD becomes the password of every demo account, admin included: a private one,
# at least 12 characters, never the development password in the repository.
ALLOW_DEMO_DATA=false
DEMO_PASSWORD=
